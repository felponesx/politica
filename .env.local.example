# Copie para .env.local (nunca commite) e preencha. Uso: docker compose -f docker-compose.local.yml --env-file .env.local up -d --build
DB_SENHA=troque-por-uma-senha-longa
DB_LEITURA_SENHA=troque-por-outra-senha-longa
# Chave gratuita do Portal da Transparência (opcional): https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
# Pesquisa na internet da IA do site (opcional)
PERPLEXITY_API_KEY=
# Avisos no celular quando uma coleta falha ou o sistema se atualiza (opcional): crie um bot no Telegram com o @BotFather
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT=
# Deixe 127.0.0.1 (só o PC). Nunca use 0.0.0.0 sem saber o que está fazendo.
API_BIND=127.0.0.1

TOMTOM_API_KEY=

MAPBIOMAS_EMAIL=
MAPBIOMAS_SENHA=

# Pasta do clone do repositório de dados do coletor do celular (padrão: ./coletor-dados)
#COLETOR_DADOS_PASTA=
# Login com a conta Google (opcional). Crie um cliente OAuth "Aplicativo da Web" no Google Cloud,
# com a origem do site em "Origens JavaScript autorizadas". Sem GOOGLE_CLIENT_ID o botão do Google some.
GOOGLE_CLIENT_ID=
# E-mails (separados por vírgula) que entram como administradores. Use o seu e-mail, só aqui no .env (nunca no repositório).
ADMIN_EMAILS=

# Conta de teste admin/admin (só para desenvolvimento): vale enquanto não existir outro administrador. Ponha false ANTES de publicar o site.
ADMIN_PADRAO=true
# Página /admin/configurar (torna admin uma conta já criada, sem terminal): chave de 32+ caracteres. Vazio = desligada.
SETUP_ADMIN_TOKEN=
