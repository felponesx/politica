 "subordinada_a": null,
 "resumo": {
  "texto": "Faz o policiamento ostensivo (fardado, nas ruas) e cuida da preservação da ordem pública no Pará. É força auxiliar e reserva do Exército.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
 },
 "fundacao": {
  "data": "1818-03-10",
  "texto": "Criada em 1818, no governo do Conde de Vila Flor, com o nome de Corpo de Polícia, sob o comando do major José Victorino de Amarante.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
 },
 "historia": [
  {
   "ano": "1818",
   "texto": "Criado o Corpo de Polícia do Grão-Pará, no governo do Conde de Vila Flor. Antes, em 1817, havia sido criado um esquadrão de cavalaria miliciana.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  },
  {
   "ano": "1897",
   "texto": "Em Canudos (BA), em 25 de setembro, o tenente-coronel Antônio Sérgio Dias Vieira da Fontoura assume o comando da tropa paraense após o ferimento do coronel Sotero de Menezes. A data virou o Dia da Força Pública.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  },
  {
   "ano": "1930",
   "texto": "Com a vitória da Revolução de 1930, a Força Pública é extinta e trocada pela Guarda Civil. Dois anos depois, ex-integrantes são chamados para conter um motim, e a corporação é reorganizada aos poucos.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  },
  {
   "ano": "1935",
   "texto": "O Decreto nº 1.516 dá à corporação o nome de Polícia Militar do Estado do Pará.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  },
  {
   "ano": "1980",
   "texto": "Inspirada nos koban japoneses, a PM cria o sistema PM-Box, cabines com rádio onde policiais ficavam de serviço; nos anos 1990 começa o policiamento comunitário.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  },
  {
   "ano": "1996",
   "texto": "Massacre de Eldorado do Carajás: em 17 de abril, 21 trabalhadores sem-terra foram mortos em ação da PM do Pará para desobstruir a rodovia.",
   "fonte": "https://pt.wikipedia.org/wiki/Massacre_de_Eldorado_do_Caraj%C3%A1s"
  },
  {
   "ano": "2012",
   "texto": "O coronel Mário Colares Pantoja, que liderou a operação de Eldorado do Carajás, e o major José Maria Pereira de Oliveira são presos, condenados pelo massacre a 228 e 158 anos de prisão.",
   "fonte": "https://pt.wikipedia.org/wiki/Massacre_de_Eldorado_do_Caraj%C3%A1s"
  },
  {
   "ano": "2014",
   "texto": "Nova Lei de Organização Básica: o efetivo previsto passa de 13 mil para 30 mil policiais e são criadas unidades como a de reabilitação, a assistência religiosa, o museu e o arquivo.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
  }
 ],
 "patrono": {
  "nome": "Coronel Antônio Sérgio Dias Vieira da Fontoura",
  "texto": "Comandou a tropa paraense na vitória em Canudos (1897) e foi comandante-geral da corporação de 1900 a 1911. Foi definido patrono em 1925; a medalha Coronel Fontoura leva seu nome.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_do_Par%C3%A1"
 },
