 "historia": [
  {
   "ano": "1837",
   "texto": "Em plena Revolução Farroupilha, a Lei Provincial nº 7, de 18 de novembro, criou a Força Policial da Província para auxiliar a justiça e manter a ordem.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "1874",
   "texto": "A Força Policial participou da campanha contra os Mucker, em Sapiranga. Em 2 de agosto, soldados mataram Jacobina Mentz Maurer e 16 seguidores.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "1892",
   "texto": "O Ato nº 357, de 15 de outubro, criou a Brigada Militar, nome mantido até hoje.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "1893",
   "texto": "Na Revolução Federalista, a Brigada lutou ao lado do governo de Júlio de Castilhos; o Combate do Salsinho é considerado seu batismo de fogo.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "1961",
   "texto": "Na Campanha da Legalidade, a Brigada guarneceu o Palácio Piratini e as antenas da Rádio Guaíba, em apoio ao governador Leonel Brizola.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "1964",
   "texto": "Durante a ditadura militar, a Brigada integrou, como força auxiliar do Exército, o aparelho de repressão política.",
   "fonte": "https://pt.wikipedia.org/wiki/Brigada_Militar_do_Rio_Grande_do_Sul"
  },
  {
   "ano": "1985",
   "texto": "Criação da Companhia de Polícia Militar Feminina, com 135 policiais.",
   "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
  },
  {
   "ano": "2024",
   "texto": "Nas enchentes de abril e maio, a maior mobilização de sua história: a Brigada contabilizou o resgate de mais de 23 mil pessoas e 5 mil animais.",
   "fonte": "https://pt.wikipedia.org/wiki/Brigada_Militar_do_Rio_Grande_do_Sul"
  }
 ],
 "patrono": {
  "nome": "Coronel Affonso Emílio Massot",
  "texto": "Instituído patrono em 20 de outubro de 1953. Dedicou a maior parte da vida à corporação, foi comandante-geral (a partir de 1917) e atuou na Revolução Federalista e na mobilização das tropas em 1923 e 1924.",
  "fonte": "https://www.brigadamilitar.rs.gov.br/historia"
