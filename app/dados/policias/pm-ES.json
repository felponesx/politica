  },
  {
   "ano": "1997",
   "texto": "O Corpo de Bombeiros deixou a PM com a Emenda Constitucional estadual nº 12, de 20 de agosto de 1997.",
   "fonte": "https://pm.es.gov.br/historia"
  },
  {
   "ano": "2017",
