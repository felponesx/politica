 "resumo": {
  "texto": "Força de segurança pública de Goiás, responsável pelo policiamento ostensivo. É força auxiliar e reserva do Exército.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_Goi%C3%A1s"
 },
 "fundacao": {
  "data": "1858-07-28",
  "texto": "O presidente da Província, Januário da Gama Cerqueira, sancionou a resolução nº 13, que criou a Força Policial de Goyaz.",
  "fonte": "https://goias.gov.br/policiamilitar/historia/"
 },
 "historia": [
  {
   "ano": "1858",
   "texto": "Criada a Força Policial de Goyaz, com 47 homens e atuação limitada à capital (Vila Boa) e arredores. Os primeiros integrantes eram civis contratados que usavam só cassetetes.",
   "fonte": "https://goias.gov.br/policiamilitar/historia/"
  },
  {
   "ano": "1863",
   "texto": "A corporação comprou seu primeiro quartel, na Cidade de Goiás, que sediou o comando até 1936.",
   "fonte": "https://goias.gov.br/policiamilitar/historia/"
  },
  {
   "ano": "1865",
   "texto": "Na Guerra do Paraguai, as tropas goianas forneceram mantimentos aos militares em combate.",
   "fonte": "https://goias.gov.br/policiamilitar/historia/"
  },
  {
   "ano": "1935",
   "texto": "Em 1º de julho surgiu o nome Polícia Militar de Goiás. Em novembro, uma companhia foi para a nova capital, Goiânia, e deu origem ao 1º Batalhão, hoje Batalhão Anhanguera.",
   "fonte": "https://goias.gov.br/policiamilitar/historia/"
  },
  {
   "ano": "1938",
   "texto": "Criado o Comando Geral da corporação; o major Arnaldo de Morais Sarmento foi nomeado comandante-geral.",
   "fonte": "https://goias.gov.br/policiamilitar/historia/"
  },
  {
   "ano": "2024",
   "texto": "A Portaria nº 19.219, de 29 de outubro de 2024, é a base legal da divisão atual da PMGO em Comandos Regionais.",
   "fonte": "https://goias.gov.br/policiamilitar/organograma-e-mapa-regional/"
  }
 ],
