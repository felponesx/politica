 "resumo": {
  "texto": "Faz o policiamento ostensivo (fardado, nas ruas) e cuida da ordem pública no estado de São Paulo. É a maior polícia do Brasil em número de policiais.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
 },
 "fundacao": {
  "data": "1831-12-15",
  "texto": "Criada por lei da Assembleia Provincial como Corpo de Guardas Municipais Permanentes, com 100 homens a pé e 30 a cavalo.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
 },
 "historia": [
  {
   "ano": "1831",
   "texto": "Em 15 de dezembro, lei da Assembleia Provincial, proposta pelo presidente da província Rafael Tobias de Aguiar, criou o Corpo de Guardas Municipais Permanentes: 100 homens a pé e 30 a cavalo.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
  },
  {
   "ano": "1906",
   "texto": "O governo paulista contratou uma Missão Militar Francesa para instruir a então Força Pública. Ela ficou até 1924 e trouxe escolas de formação, o estado-maior e o uso de bicicletas e cães.",
   "fonte": "https://www.policiamilitar.sp.gov.br/institucional/historia-da-pm"
  },
  {
   "ano": "1932",
   "texto": "Na Revolução Constitucionalista, a Força Pública, com cerca de 10 mil homens, foi o centro das tropas paulistas que lutaram por três meses contra o governo Vargas.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
  },
  {
   "ano": "1970",
   "texto": "A Força Pública se uniu à Guarda Civil e formou a atual Polícia Militar. No mesmo ano, em 15 de outubro, foram criadas as Rondas Ostensivas Tobias de Aguiar (Rota).",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
  },
  {
   "ano": "1992",
   "texto": "Em 2 de outubro, uma ação da PM para conter rebelião na Casa de Detenção (Carandiru) deixou 111 presos mortos. Júris condenaram 74 policiais; o TJ-SP anulou em 2016, o STJ restabeleceu as condenações em 2021 e o STF manteve em 2022.",
   "fonte": "https://pt.wikipedia.org/wiki/Massacre_do_Carandiru"
  },
  {
   "ano": "1997",
   "texto": "Policiais militares foram filmados torturando e matando um civil na Favela Naval, em Diadema. O caso virou escândalo e levou à demissão de vários policiais.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
  },
  {
   "ano": "2026",
   "texto": "Pela primeira vez em 194 anos, uma mulher foi nomeada comandante-geral da PMESP: a coronel Glauce Anselmo Cavalli.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
  }
 ],
 "patrono": {
  "nome": "Brigadeiro Rafael Tobias de Aguiar",
  "texto": "Presidente da Província de São Paulo, propôs a lei de 15 de dezembro de 1831 que criou a corporação. É o patrono da PMESP, e a Rota (Rondas Ostensivas Tobias de Aguiar) leva seu nome.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Estado_de_S%C3%A3o_Paulo"
