 "resumo": {
  "texto": "Faz o policiamento ostensivo (fardado, nas ruas) e cuida da preservação da ordem pública em Pernambuco. É órgão da Secretaria de Defesa Social e força auxiliar e reserva do Exército.",
  "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_de_Pernambuco"
 },
 "fundacao": {
  "data": "1825-06-11",
  "texto": "Decreto imperial de Pedro I criou um Corpo de Polícia na província de Pernambuco, depois da Confederação do Equador (1824), com 320 homens.",
  "fonte": "https://www.pm.pe.gov.br/historico/"
 },
 "historia": [
  {
   "ano": "1636",
   "texto": "Um contrato de Maurício de Nassau com a Companhia das Índias Ocidentais, de 23 de agosto de 1636, já faz referência à existência de uma polícia militar, segundo a PMPE.",
   "fonte": "https://www.pm.pe.gov.br/historico/"
  },
  {
   "ano": "1825",
   "texto": "Decreto imperial cria o Corpo de Polícia do Recife, com 320 homens e quartel no Pátio do Paraíso. O 1º comandante, Antônio Maria da Silva Torres, tinha participado da repressão aos revolucionários de 1824.",
   "fonte": "https://www.pm.pe.gov.br/historico/"
  },
  {
   "ano": "1891",
   "texto": "Depois de chamar-se Corpo de Guardas Municipais Permanentes, Força Policial e Guarda Cívica, a corporação vira Brigada Policial do Estado de Pernambuco.",
   "fonte": "https://www.pm.pe.gov.br/historico/"
  },
  {
   "ano": "1913",
   "texto": "A Lei nº 1.165 transforma a corporação em Força Pública do Estado de Pernambuco.",
   "fonte": "https://www.pm.pe.gov.br/historico/"
  },
  {
   "ano": "1920",
   "texto": "No início da década de 1920 é erguido o Quartel do Derby, no Recife, no terreno de um antigo hipódromo e de um mercado destruído por incêndio. Hoje é o quartel do comando-geral.",
   "fonte": "https://pt.wikipedia.org/wiki/Quartel_do_Derby"
  },
  {
   "ano": "1947",
   "texto": "Decreto de 1º de janeiro dá à corporação o nome atual: Polícia Militar de Pernambuco.",
   "fonte": "https://www.pm.pe.gov.br/historico/"
  }
