  },
  {
   "ano": "1938",
   "texto": "Depois de vários nomes (Corpo Policial, Batalhão Militar de Segurança, Força Policial), a corporação passa a se chamar Polícia Militar do Amazonas, em 14 de novembro.",
   "fonte": "https://pm.am.gov.br/portal/pagina/historia_da_pmam"
  },
  {
   "ano": "1942",
   "texto": "Na Segunda Guerra Mundial, a PMAM ajuda no esforço da borracha: policiamento e transporte dos soldados da borracha, hospedarias para migrantes e serviços no porto de Manaus.",
   "fonte": "https://pt.wikipedia.org/wiki/Pol%C3%ADcia_Militar_do_Amazonas"
  },
  {
   "ano": "1983",
   "texto": "Pela primeira vez o comando-geral é ocupado por um coronel da própria PMAM, Hélcio Rodrigues Mota. No mesmo ano, 8 de novembro entra no calendário como data do retorno da campanha de Canudos.",
   "fonte": "https://pm.am.gov.br/portal/pagina/historia_da_pmam"
  },
  {
   "ano": "2002",
   "texto": "O Regimento de Policiamento Montado, criado em 1988 como esquadrão, recebe o nome de Regimento Coronel Bentes, em homenagem ao seu primeiro comandante.",
