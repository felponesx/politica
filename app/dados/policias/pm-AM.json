 "historia": [
  {
   "ano": "1837",
   "texto": "Criada a Guarda Policial, com a missão de combater a revolta da Cabanagem (1835–1840). O primeiro comandante foi o tenente-coronel de artilharia Albino dos Santos Pereira.",
   "fonte": "https://pm.am.gov.br/portal/pagina/historia_da_pmam"
  },
  {
   "ano": "1897",
   "texto": "Na quarta expedição contra Canudos (BA), a PMAM participa com o 1º Batalhão de Infantaria, sob o comando do tenente-coronel Cândido Mariano.",
