# Copie para .env.prod e preencha. NUNCA envie este arquivo para o Git.
DOMINIO=brasilmais.seudominio.com.br
# Gere senhas fortes:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_SENHA=
DB_LEITURA_SENHA=
# Chave gratuita do Portal da Transparência (opcional, liga órgãos e gastos federais)
TRANSPARENCIA_API_KEY=
# IA do site: busca e pesquisa na internet pelo Perplexity (POST /busca/web e /ia/web; opcional)
PERPLEXITY_API_KEY=
# Alertas de falha (opcional): bot do Telegram (@BotFather) ou um webhook qualquer
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT=
ALERTA_WEBHOOK_URL=
LIMITE_REQ_POR_MINUTO=120
# Documentação interativa da API (/docs): deixe false em produção

# Login com a conta Google (opcional). Crie um cliente OAuth "Aplicativo da Web" no Google Cloud,
# com a origem do site em "Origens JavaScript autorizadas". Sem GOOGLE_CLIENT_ID o botão do Google some.
GOOGLE_CLIENT_ID=
# E-mails (separados por vírgula) que entram como administradores. Use o seu e-mail, só aqui no .env (nunca no repositório).
ADMIN_EMAILS=
