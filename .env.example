# Banco (Postgres via docker-compose). Para testar rápido sem Postgres: sqlite:///./brasilplus.db
DATABASE_URL=postgresql+psycopg://brasil:brasil@localhost:5432/brasilplus
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
# Token para disparar coletas pela API (POST /coletas). Use 24+ caracteres: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# IA do site: busca e pesquisa na internet pelo Perplexity (POST /busca/web e /ia/web; opcional). Chave em https://console.perplexity.ai/project/keys
PERPLEXITY_API_KEY=
# Alertas de falha das coletas (opcional)
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT=
ALERTA_WEBHOOK_URL=

# Trânsito das capitais (TomTom Traffic API, chave gratuita em developer.tomtom.com). Só aqui no servidor, nunca no site.
TOMTOM_API_KEY=
TOMTOM_LIMITE_DIA=2000

# MapBiomas Alerta (alertas com área por território): conta criada em plataforma.alerta.mapbiomas.org (e-mail confirmado). Só aqui no servidor.
MAPBIOMAS_EMAIL=
MAPBIOMAS_SENHA=

# Login com a conta Google (opcional). Crie um cliente OAuth "Aplicativo da Web" no Google Cloud,
# com a origem do site em "Origens JavaScript autorizadas". Sem GOOGLE_CLIENT_ID o botão do Google some.
GOOGLE_CLIENT_ID=
# E-mails (separados por vírgula) que entram como administradores. Use o seu e-mail, só aqui no .env (nunca no repositório).
ADMIN_EMAILS=

# Conta de teste admin/admin (só para desenvolvimento): vale enquanto não existir outro administrador. Ponha false ANTES de publicar o site.
ADMIN_PADRAO=true
# Página /admin/configurar (torna admin uma conta já criada, sem terminal): chave de 32+ caracteres. Vazio = desligada.
SETUP_ADMIN_TOKEN=
